{
  "manifest_version": 3,
  "name": "Random Tab Switcher",
  "description": "Switch browser tabs randomly at random time intervals",
  "version": "1.0",
  "permissions": ["tabs", "storage"],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png"
    }
  }
}
